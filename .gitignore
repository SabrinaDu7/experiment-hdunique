.envrc
.venv/
__pycache__/
*.pyc

# Results: the parquets are the artefact and are tracked. The decode cache is ~22 MB of
# regenerable binary, and figures are regenerable from the parquets/cache, so neither is.
outputs/*
!outputs/results/
outputs/results/*
!outputs/results/*.parquet
!outputs/results/variance_by_window*.csv
