.envrc
.venv/
__pycache__/
*.pyc

# Results. The parquets ARE the artefact; the decode cache is shipped too (~22 MB) so that
# --recompute-only and the figure commands work on a fresh clone without the multi-hour sweep.
# Figures are regenerable from those in seconds, so they are not tracked.
outputs/*
!outputs/results/
outputs/results/*
!outputs/results/*.parquet
!outputs/results/*.csv
!outputs/results/cache/

# Scratch space for quick one-offs; the .gitkeep is tracked, nothing else is.
throwaway/*
!throwaway/.gitkeep

# Generated results docs and the values they render from ARE tracked; figures too, since the
# generated .md files link to them.
!outputs/results/*.json
!outputs/figures/
