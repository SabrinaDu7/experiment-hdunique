.envrc
.venv/
__pycache__/
*.pyc
.ruff_cache/

# outputs/: the decode cache is shipped (~22 MB) so a fresh clone can run every analysis without
# the multi-hour sweep. Result tables, the values files the docs render from, and the figures the
# docs link to are all tracked. Nothing else under outputs/ is.
outputs/*
!outputs/cache/
!outputs/results/
outputs/results/*
!outputs/results/*.parquet
!outputs/results/*.csv
!outputs/results/*.json
!outputs/figures/
outputs/figures/*
!outputs/figures/*.png

# Scratch space for quick one-offs; the .gitkeep is tracked, nothing else is.
throwaway/*
!throwaway/.gitkeep
